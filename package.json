{
  "name": "fixmyfeed",
  "version": "0.0.0",
  "private": true,
  "description": "FixMyFeed monorepo — product-feed diagnostics and repair.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:boundaries": "node --test tests/boundaries.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:tenancy": "node --test tests/tenancy.test.mjs",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test": "node --test tests/auth.test.mjs tests/boundaries.test.mjs tests/tooling.test.mjs tests/tenancy.test.mjs",
    "check:traceability": "node tools/traceability/check.mjs",
    "check:backup-restore": "node tools/backup-restore/check.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:traceability && pnpm run check:backup-restore",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run typecheck && pnpm run test"
  },
  "lint-staged": {
    "*.{ts,mts,cts,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "24.9.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "simple-git-hooks": "^2.11.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.15.0"
  }
}
